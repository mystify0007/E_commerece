# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI service (optional external adapter — content-based engine works without this)
AI_API_KEY=
AI_API_URL=

# Payment (sandbox/test mode)
PAYMENT_API_KEY=
PAYMENT_SECRET=

# eSewa ePay v2 — leave unset to use eSewa's own public sandbox merchant
# (EPAYTEST) automatically; set these only when you have real merchant
# credentials to go live.
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=
ESEWA_STATUS_URL=

# Email (password reset, notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@juttax.local
